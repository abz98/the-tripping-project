{
  "compilerOptions": {
    "baseUrl": "./src",
    "paths": {
      "@src/*": ["*"]
    },
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "outDir": "./dist",
    "module": "ESNext",
    "target": "ES2020",
    "strict": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
