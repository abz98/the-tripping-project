{
  "name": "the-tripping-project",
  "version": "1.0.0",
  "description": "Travel and trip management application",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "lint": "npx eslint src/**/**/**/**/*.ts --no-ignore",
    "lint:fix": "npx eslint src/**/**/**/**/*.ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "db:check": "node --loader ts-node/esm src/scripts/db-check.ts",
    "seed:roles": "tsx src/scripts/seed-roles.ts",
    "seed:cities": "tsx src/scripts/seed-cities.ts",
    "seed:categories": "tsx src/scripts/seed-categories.ts",
    "seed:banners": "tsx src/scripts/seed-banners.ts",
    "seed:all": "npm run seed:roles && npm run seed:categories && npm run seed:banners && npm run seed:cities",
    "setup:chat-indexes": "tsx src/scripts/setup-chat-indexes.ts",
    "docker:start": "docker-compose down && docker rm -f mongodb-local redis-local minio-local 2>/dev/null || true && docker-compose up -d",
    "docker:stop": "docker-compose down",
    "docker:clean": "docker-compose down -v && docker rm -f mongodb-local redis-local minio-local 2>/dev/null || true",
    "docker:logs": "docker-compose logs -f",
    "docker:ps": "docker-compose ps",
    "monitor": "./monitor-memory.sh",
    "monitor:watch": "./monitor-watch.sh",
    "monitor:docker": "docker stats",
    "monitor:api": "curl -s http://localhost:3001/health/memory | json_pp"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abz98/the-tripping-project.git"
  },
  "keywords": [
    "travel",
    "trip",
    "management"
  ],
  "author": "abz98 <abhi.jpatil98@gmail.com>",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/abz98/the-tripping-project/issues"
  },
  "homepage": "https://github.com/abz98/the-tripping-project#readme",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "minio": "^8.0.6",
    "mongoose": "^8.1.0",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.12",
    "razorpay": "^2.9.6",
    "redis": "^5.10.0",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/minio": "^7.1.0",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.11.0",
    "@types/nodemailer": "^7.0.5",
    "@types/socket.io": "^3.0.2",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "fast-check": "^4.5.3",
    "jest": "^29.7.0",
    "prettier": "^3.2.4",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.3.3"
  }
}
